# Domain only: no https://, port, path, or trailing slash.
DOMAIN=meta-edu.ru
# Nginx Proxy Manager connects to meta-education:3000 on the proxy network.
# Trust one proxy hop: NPM appends the client IP to X-Forwarded-For.
TRUST_PROXY=true

# Keep the OLD values when updating an existing installation; see deploy/VPS.md.
COMPOSE_PROJECT_NAME=meta-education-production
POSTGRES_USER=meta_education
POSTGRES_DB=meta_education

# Generate with: openssl rand -hex 32
# Use hexadecimal characters only, since this is also part of DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD

# First teacher account for the NEW production database.
# A minimum of 12 characters; single quotes preserve literal $ and #.
ADMIN_EMAIL=teacher@example.ru
ADMIN_PASSWORD='REPLACE_WITH_A_UNIQUE_LONG_PASSWORD'
ADMIN_NAME='Анна Сергеевна'

# Private Yandex Object Storage bucket and service-account static access key.
S3_BUCKET=your-private-bucket-name
S3_ACCESS_KEY_ID=REPLACE_WITH_YANDEX_KEY_ID
S3_SECRET_ACCESS_KEY='REPLACE_WITH_YANDEX_SECRET'
