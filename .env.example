# Local demonstration: JSON persistence, demo role switch, no external services.
DEMO_MODE=true

# Production: set DEMO_MODE=false and configure PostgreSQL + private S3 bucket.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Анна Сергеевна
APP_URL=http://localhost:3000

S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Change only when deploying behind a trusted proxy which overwrites this header.
TRUST_PROXY=false
